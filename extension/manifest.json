{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_appName__",
  "short_name": "Inkling",
  "version": "1.0.2",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://github.com/alex-chan/inkling",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cnn.com/*",
        "*://*.nbcnews.com/*",
        "*://*.cnbc.com/*",
        "*://*.reuters.com/*",
        "*://*.bbc.com/*",
        "*://*.bbc.co.uk/*",
        "*://news.google.com/*",
        "*://*.wsj.com/*",
        "*://*.youtube.com/*",
        "*://*.nytimes.com/*",
        "*://*.theguardian.com/*",
        "*://*.apnews.com/*",
        "*://*.bloomberg.com/*",
        "*://*.washingtonpost.com/*",
        "*://*.ft.com/*",
        "*://*.economist.com/*",
        "*://*.npr.org/*",
        "*://*.aljazeera.com/*",
        "*://abcnews.go.com/*",
        "*://*.cbsnews.com/*",
        "*://*.foxnews.com/*",
        "*://*.politico.com/*",
        "*://*.axios.com/*",
        "*://*.theatlantic.com/*",
        "*://*.newyorker.com/*",
        "*://time.com/*",
        "*://*.usatoday.com/*",
        "*://*.forbes.com/*",
        "*://*.businessinsider.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "scripting"
  ],
  "host_permissions": [
    "*://*.cnn.com/*",
    "*://*.nbcnews.com/*",
    "*://*.cnbc.com/*",
    "*://*.reuters.com/*",
    "*://*.bbc.com/*",
    "*://*.bbc.co.uk/*",
    "*://news.google.com/*",
    "*://*.wsj.com/*",
    "*://*.youtube.com/*",
    "*://*.nytimes.com/*",
    "*://*.theguardian.com/*",
    "*://*.apnews.com/*",
    "*://*.bloomberg.com/*",
    "*://*.washingtonpost.com/*",
    "*://*.ft.com/*",
    "*://*.economist.com/*",
    "*://*.npr.org/*",
    "*://*.aljazeera.com/*",
    "*://abcnews.go.com/*",
    "*://*.cbsnews.com/*",
    "*://*.foxnews.com/*",
    "*://*.politico.com/*",
    "*://*.axios.com/*",
    "*://*.theatlantic.com/*",
    "*://*.newyorker.com/*",
    "*://time.com/*",
    "*://*.usatoday.com/*",
    "*://*.forbes.com/*",
    "*://*.businessinsider.com/*",
    "https://api.openai.com/*",
    "https://auth.openai.com/*",
    "http://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "callback.html"
      ],
      "matches": [
        "https://auth.openai.com/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
